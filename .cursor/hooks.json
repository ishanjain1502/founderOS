{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": ".cursor/hooks/entire-cursor.sh before-submit-prompt"
      }
    ],
    "preCompact": [
      {
        "command": ".cursor/hooks/entire-cursor.sh pre-compact"
      }
    ],
    "sessionEnd": [
      {
        "command": ".cursor/hooks/entire-cursor.sh session-end"
      }
    ],
    "sessionStart": [
      {
        "command": ".cursor/hooks/entire-cursor.sh session-start"
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/entire-cursor.sh stop"
      }
    ],
    "subagentStart": [
      {
        "command": ".cursor/hooks/entire-cursor.sh subagent-start"
      }
    ],
    "subagentStop": [
      {
        "command": ".cursor/hooks/entire-cursor.sh subagent-stop"
      }
    ]
  }
}
